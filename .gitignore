# ---- hub branch (main): site + paper only ----
# Fundraising / IR materials — contain personal contact info, LOCAL ONLY, never commit
paper/*.pdf
paper/*.html
paper/BLUEPOINT_APPLY.md
# Exception: the arXiv preprint PDF itself is public (compiled from tracked wpu.tex, no personal info)
!paper/wpu.pdf

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg

# ---- local working dirs carried over from the code branch (never on the hub) ----
build/
scratchpad/
scratchpad_build/
impl/
fpga/out/
.claude/worktrees/
__pycache__/
*.pyc
*.vcd
.Xil/
.deferred/
clockInfo.txt
cong/
iter_*_CongestedCLBsAndNets.txt
tight_setup_hold_pins.txt

# Generated routing traces (tools/route_trace.py --dump). They belong to the model
# branches, which ignore them too -- but they survive a `git checkout main`, so
# without this rule a `git add -A` on the hub silently stages ~54k lines of them.
tools/*.hex
